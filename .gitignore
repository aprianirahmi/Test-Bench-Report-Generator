# Environment
backend/.env
.env
.env.*

# SQLite
backend/data.db
*.db
*.sqlite
*.sqlite3

# Frontend
frontend/node_modules/
frontend/dist/

# VSCode
.vscode/

# Generated files
repomix-output.xml

# Logs
*.log

# Go build
*.exe
*.out

backend/client_cert.pem
backend/client_key.pem
*.pem
# TLS credentials (never commit)
backend/client_cert.pem
backend/client_key.pem
*.pem

# SQLite journal files
*.db-shm
*.db-wal
*.bak-darktheme

repomix-output*.xml

# Go live-reload (Air) build output
backend/tmp/

# Frontend embedded into the Go binary (generated by build-frontend.*;
# only the .gitkeep placeholder is tracked)
backend/assets/frontend_dist/*
!backend/assets/frontend_dist/.gitkeep
